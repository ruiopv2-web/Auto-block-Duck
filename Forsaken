local function extractSoundId(soundIdUrl)
    if not soundIdUrl or soundIdUrl == "" then return nil end
    return string.match(soundIdUrl, "(%d+)$")
end

local function isInLobby(obj)
    if not obj then return false end
    local current = obj
    while current and current ~= Workspace do
        local name = string.lower(current.Name)
        if string.find(name, "lobby") or string.find(name, "waiting") or string.find(name, "menu") or string.find(name, "room") then
            return true
        end
        current = current.Parent
    end
    return false
end

