-- ===== เช็คว่ามีกำแพงกั้นระหว่าง killer กับเราหรือไม่ =====
local function hasLineOfSight(fromPos, toPos, ignoreChar1, ignoreChar2)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {}
    if ignoreChar1 then table.insert(ignoreList, ignoreChar1) end
    if ignoreChar2 then table.insert(ignoreList, ignoreChar2) end
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    rayParams.FilterDescendantsInstances = ignoreList
    rayParams.IgnoreWater = true
    local dir = toPos - fromPos
    local result = Workspace:Raycast(fromPos, dir, rayParams)
    return result == nil   -- true = เห็นกัน (ไม่มีกำแพงกั้น)
end

local function spawnHitboxAndCheck(character, customConfig)
    if isInLobby(character) or isBeheadSkill(character) or hitboxConnections[character] then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    -- ตรวจสอบเร็ว: ถ้าเราตาย/ไม่มีตัวละคร ไม่ต้องสร้าง
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHRP or not myHum or myHum.Health <= 0 then return end

    local activeVisibleTime = (customConfig and customConfig.hitboxTime) or Settings.VisibleTime or 0.4
    local boxSize = Vector3.new(Settings.BoxSizeWidth, Settings.BoxSizeHeight, Settings.BoxSizeDepth)
    local forwardOffset = -(Settings.BoxSizeDepth / 2) - Settings.HitboxDistance

    local box = Instance.new("Part")
    box.Name = "Fast_Predict_Box_" .. character.Name
    box.Size = boxSize
    box.Color = Settings.BoxColor
    box.Transparency = Settings.HitboxEnabled and Settings.BoxTransparency or 1
    box.Material = Settings.GlowMode and Enum.Material.Neon or Enum.Material.SmoothPlastic
    box.CanCollide, box.CanQuery, box.Massless, box.Anchored = false, false, true, true
    box.CFrame = hrp.CFrame * CFrame.new(0, 0, forwardOffset)
    box.Parent = Workspace
    activeHitboxes[character] = box

    local startTime = os.clock()
    local hasTriggeredBlock = false
    local pingSec = getPingCompensation()
    local vel = hrp.AssemblyLinearVelocity or Vector3.zero

    -- สร้าง OverlapParams ใหม่ทุก hitbox (ไม่แชร์กัน)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = {myChar}

    local eventToUse = RunService:FindFirstChild("PreSimulation") or RunService.Stepped
    hitboxConnections[character] = eventToUse:Connect(function()
        local timeAlive = os.clock() - startTime
        if timeAlive > activeVisibleTime or currentlyBeheading[character] or isBeheadSkill(character) then
            if box and box.Parent then box:Destroy() end
            activeHitboxes[character] = nil
            if hitboxConnections[character] then
                hitboxConnections[character]:Disconnect()
                hitboxConnections[character] = nil
            end
            return
        end
        -- ย้ายกล่องตาม killer + คำนวณความเร็ว (prediction)
        if hrp then
            local predictedPos = hrp.Position + (Vector3.new(vel.X, 0, vel.Z) * pingSec)
            box.CFrame = CFrame.new(predictedPos, predictedPos + hrp.CFrame.LookVector) * CFrame.new(0, 0, forwardOffset)
        end
        if character ~= myChar and Settings.MasterAutoBlock and not hasTriggeredBlock and myHRP then
            local partsInBox = Workspace:GetPartBoundsInBox(box.CFrame, boxSize, params)
            if #partsInBox > 0 then
                -- กรองเฉพาะส่วนสำคัญของร่างกาย (ไม่เอา hat/accessory)
                local hitCore = false
                for _, part in ipairs(partsInBox) do
                    local pn = part.Name
                    if pn == "HumanoidRootPart" or pn == "Torso" or pn == "UpperTorso" or pn == "LowerTorso" or pn == "Head" then
                        hitCore = true
                        break
                    end
                end
                if hitCore and hasLineOfSight(hrp.Position, myHRP.Position, character, myChar) then
                    hasTriggeredBlock = true
                    if box then box.Color = Color3.fromRGB(255, 0, 0) end
                    performBlock()
                end
            end
        end
    end)
end

