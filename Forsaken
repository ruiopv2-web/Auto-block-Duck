local function getPingCompensation()
    local now = os.clock()
    if now - lastPingUpdate > 1 then          -- อัพเดททุก 1 วินาที พอ
        lastPingUpdate = now
        local success, ping = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        end)
        cachedPing = (success and ping and ping > 0) and ping or 0.08
    end
    return cachedPing
end

