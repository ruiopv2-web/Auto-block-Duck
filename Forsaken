    local current = sound.Parent
    while current and current ~= Workspace do
        local currentName = string.lower(current.Name)
        for _, keyword in ipairs(IgnoredKeywords) do
            if string.find(currentName, keyword) then
                return true
            end
        end
        current = current.Parent
    end

    return false
end

local function getCharacterFromSound(sound)
    local current = sound.Parent
    while current and current ~= Workspace do
        if current:FindFirstChildOfClass("Humanoid") and current:FindFirstChild("HumanoidRootPart") then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function setupSound(sound)
    if not sound:IsA("Sound") or hookedSounds[sound] then return end
    hookedSounds[sound] = true

    local function refreshSoundCache()
        local rawId = sound.SoundId
        if not rawId or rawId == "" then soundDataCache[sound] = nil return end
        local numId = string.match(rawId, "%d+$")
        if not numId then soundDataCache[sound] = nil return end
        if isIgnoredSoundSource(sound) then soundDataCache[sound] = nil return end

        -- ===== แก้ #1 + #2: รับทั้ง true และ table จาก KillerSounds =====
        local soundInfo = KillerSounds and KillerSounds[numId]
        if not soundInfo then soundDataCache[sound] = nil return end
        local isBehead = BeheadIDs and BeheadIDs[numId] == true
        if isBehead then soundDataCache[sound] = nil return end

        -- ถ้าเป็น table = มี custom config ถ้าเป็น true = ใช้ค่า default
        local customConfig = (type(soundInfo) == "table") and soundInfo or nil

        soundDataCache[sound] = {
            numId = numId,
            character = getCharacterFromSound(sound),
            customConfig = customConfig,
            lastTriggerTime = 0
        }
    end

    refreshSoundCache()
    sound:GetPropertyChangedSignal("SoundId"):Connect(refreshSoundCache)
    sound:GetPropertyChangedSignal("Parent"):Connect(refreshSoundCache)

    local function onSoundTriggered()
        if not Settings.AutoBlockSound or not Settings.MasterAutoBlock then return end
        if isIgnoredSoundSource(sound) then return end
        local cache = soundDataCache[sound]
        if not cache then return end

        local currentTime = os.clock()
        if currentTime - cache.lastTriggerTime < 0.05 then return end  -- เพิ่มเป็น 0.05 ลด trigger ซ้ำ
        cache.lastTriggerTime = currentTime

        local character = cache.character or getCharacterFromSound(sound)
        if not character or character == LocalPlayer.Character then return end
        if isBeheadSkill(character) then return end
        if not cache.character then cache.character = character end

        -- เสียง M1 เล่น → Unified Fast Trigger (แสดง hitbox ทันที + บล็อกเร็ว)
        triggerM1Fast(character, "Sound", cache.customConfig)
    end

    -- ===== #6 เร็วขึ้น: เก็บแค่ Played + Resumed (ลบ PropertyChanged ที่ทำให้ trigger ซ้ำ) =====
    sound.Played:Connect(onSoundTriggered)
    sound.Resumed:Connect(onSoundTriggered)
    if sound.IsPlaying then onSoundTriggered() end
end

