local function performBlock(customDelay)
    -- เร็วที่สุด: ยิงตรงๆ ไม่ห่อ pcall (ลด overhead) cooldown เหลือ 0.2s
    if not Settings.MasterAutoBlock or not blockRemote or not blockArgs then return end
    local now = os.clock()
    if now - lastBlockTime < 0.2 then return end
    lastBlockTime = now
    local delay = customDelay or Settings.BlockDelay or 0
    if delay > 0 then
        task.delay(delay, function()
            blockRemote:FireServer("UseActorAbility", blockArgs)
        end)
    else
        blockRemote:FireServer("UseActorAbility", blockArgs)
    end
end

-- ===== Unified Fast Trigger: เสียง/อนิเมชั่น อันไหนมาก่อน → แสดง hitbox ทันที =====
local lastTriggerByChar = {}
local function triggerM1Fast(character, source, customConfig)
    if not character or character == LocalPlayer.Character then return end
    if not Settings.MasterAutoBlock then return end
    if isBeheadSkill(character) then return end

    local now = os.clock()
    -- อันไหน trigger ก่อน (ภายใน 0.15s) จะชนะ อีกตัวไม่ต้องทำซ้ำ
    local lastTrig = lastTriggerByChar[character] or 0
    if now - lastTrig < 0.15 then return end
    lastTriggerByChar[character] = now
    lastBlockByChar[character] = now

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not myHRP or not hrp or not myHum or myHum.Health <= 0 then
        spawnHitboxAndCheck(character, customConfig)
        return
    end

    -- แสดง hitbox ทันที (ตามที่ต้องการ ไม่รอเช็คอะไร)
    spawnHitboxAndCheck(character, customConfig)

    -- Fast path: เช็คแค่ระยะ → บล็อกทันที ไม่รอ LOS/AABB (เร็วที่สุด)
    local pingSec = getPingCompensation()
    local maxReach = Settings.BoxSizeDepth + Settings.HitboxDistance + 4 + (pingSec * 22) + (avgFrameTime * 30)
    local diff = myHRP.Position - hrp.Position
    local distSq = diff.X*diff.X + diff.Y*diff.Y + diff.Z*diff.Z
    if distSq <= maxReach * maxReach then
        performBlock()
    end
end

