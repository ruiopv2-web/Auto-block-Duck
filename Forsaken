local function isFakeGenerator(obj)
    if not obj then return false end
    local name = string.lower(obj.Name)
    return string.find(name, "fake") ~= nil or string.find(name, "decoy") ~= nil
end

local function isCollectibleItem(obj)
    if not obj then return false end
    return obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")
end

local function isJohnDoeActive()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and string.find(string.lower(player.Character.Name), "johndoe") then
            return true
        end
    end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            if string.find(string.lower(obj.Name), "johndoe") then
