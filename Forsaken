local function createToggle(parentTab, texts, settingKey, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(40, 40, 40)
    btn.Text = "   " .. texts[Settings.Language] .. " : " .. (Settings[settingKey] and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parentTab
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    table.insert(UILanguageRegistry, {
        Type = "Toggle",
        Obj = btn,
        Texts = texts,
        GetValue = function() return Settings[settingKey] end
    })

    btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        btn.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(40, 40, 40)
        btn.Text = "   " .. texts[Settings.Language] .. " : " .. (Settings[settingKey] and "ON" or "OFF")
        callback(Settings[settingKey])
    end)
end

local function createInput(parentTab, texts, settingKey, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.Parent = parentTab
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.65, 0, 1, 0)
